{
  "description": "Sets edited files to git's checkout line endings and reports indentation that does not match the surrounding file without rewriting it.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/whitespace-guard.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking line endings and indentation"
          }
        ]
      }
    ]
  }
}
