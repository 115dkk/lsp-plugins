{
  "description": "Runs the project's own ESLint on each JS, TS or Svelte file Claude edits and passes the findings to Claude.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/eslint-after-edit.mjs"
            ],
            "timeout": 60,
            "statusMessage": "ESLint on the edited file"
          }
        ]
      }
    ]
  }
}
