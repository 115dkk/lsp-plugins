{
  "description": "Sets line endings in the content Write is about to save, reports indentation mismatches, and never writes files itself.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/whitespace-guard.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Matching git's line endings"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/whitespace-guard.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking indentation"
          }
        ]
      }
    ]
  }
}
